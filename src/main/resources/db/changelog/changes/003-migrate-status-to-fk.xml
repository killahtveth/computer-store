<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="4" author="student">
        <comment>Добавить колонку status_id в computers (пока nullable)</comment>

        <addColumn tableName="computers">
            <column name="status_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_computers_status"
                             references="computer_statuses(id)"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="computers" columnName="status_id"/>
        </rollback>
    </changeSet>

    <changeSet id="5" author="student">
        <comment>Перенести данные из status (VARCHAR) в status_id (FK)</comment>

        <sql>
            UPDATE computers c
            SET status_id = s.id
            FROM computer_statuses s
            WHERE c.status = s.code;
        </sql>

        <rollback>
            <sql>
                UPDATE computers SET status_id = NULL;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="6" author="student">
        <comment>Сделать status_id обязательным</comment>

        <addNotNullConstraint tableName="computers"
                              columnName="status_id"
                              columnDataType="BIGINT"/>

        <rollback>
            <dropNotNullConstraint tableName="computers"
                                   columnName="status_id"
                                   columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="7" author="student">
        <comment>Удалить старую колонку status (VARCHAR)</comment>

        <dropColumn tableName="computers" columnName="status"/>

        <rollback>
            <addColumn tableName="computers">
                <column name="status" type="VARCHAR(50)"/>
            </addColumn>
            <sql>
                UPDATE computers c
                SET status = s.code
                FROM computer_statuses s
                WHERE c.status_id = s.id;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>