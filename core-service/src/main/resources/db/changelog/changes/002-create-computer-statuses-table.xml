<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="student">
        <comment>Создать справочник статусов компьютеров</comment>

        <createTable tableName="computer_statuses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="computer_statuses"/>
        </rollback>
    </changeSet>

    <changeSet id="3" author="student">
        <comment>Заполнить справочник статусов начальными значениями</comment>

        <insert tableName="computer_statuses">
            <column name="code" value="AVAILABLE"/>
            <column name="name" value="В наличии"/>
        </insert>
        <insert tableName="computer_statuses">
            <column name="code" value="SOLD"/>
            <column name="name" value="Продан"/>
        </insert>

        <rollback>
            <delete tableName="computer_statuses">
                <where>code IN ('AVAILABLE', 'SOLD')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>